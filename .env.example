# Base URLs — defaults are set in playwright.config.ts, override here for custom environments
UI_URL=https://practicesoftwaretesting.com
API_URL=https://api.practicesoftwaretesting.com

# Admin credentials (required)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Customer credentials (required for UI and user lifecycle tests)
CUSTOMER_USERNAME=
CUSTOMER_PASSWORD=
CUSTOMER_FIRST_NAME=
CUSTOMER_LAST_NAME=

# Guest credentials (required for guest UI tests)
GUEST_USERNAME=
GUEST_PASSWORD=
